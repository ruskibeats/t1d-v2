{
  "expo": {
    "name": "Sato",
    "slug": "sato",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F2EA"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sato.t1d"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F2EA"
      },
      "package": "com.sato.t1d"
    },
    "scheme": "sato",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "134c828f-271f-4c94-aeb9-f7ff96aeaa78"
      }
    }
  }
}
